<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Sales:etc/pdf_file.xsd">
    <totals>
        <!-- After shipping (400), before adjustments (500) -->
        <total name="walley_voucher">
            <title translate="true">Voyado voucher</title>
            <source_field>walley_voucher_amount</source_field>
            <model>Webbhuset\CollectorCheckout\Model\Sales\Pdf\VoucherTotal</model>
            <font_size>7</font_size>
            <display_zero>false</display_zero>
            <sort_order>450</sort_order>
        </total>
    </totals>
</config>
