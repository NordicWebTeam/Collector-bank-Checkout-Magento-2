<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_before">
        <observer name="Webbhuset_CollectorCheckout_sales_model_service_quote_submit_before" instance="Webbhuset\CollectorCheckout\Observer\SaveOrderBeforeSalesModelQuoteObserver" />
    </event>
    <event name="sales_model_service_quote_submit_success">
        <observer name="Webbhuset_CollectorCheckout_save_order_vouchers"
                  instance="Webbhuset\CollectorCheckout\Observer\Voucher\SaveOrderVouchers" />
    </event>
    <event name="sales_order_invoice_save_after">
        <observer name="Webbhuset_CollectorCheckout_save_invoice_vouchers"
                  instance="Webbhuset\CollectorCheckout\Observer\Voucher\SaveInvoiceVouchers" />
    </event>
    <event name="sales_invoice_item_save_after">
        <observer name="Webbhuset_CollectorCheckout_save_invoice_item_voucher"
                  instance="Webbhuset\CollectorCheckout\Observer\Voucher\SaveInvoiceItemVoucher" />
    </event>
    <event name="sales_order_creditmemo_save_after">
        <observer name="Webbhuset_CollectorCheckout_save_creditmemo_vouchers"
                  instance="Webbhuset\CollectorCheckout\Observer\Voucher\SaveCreditmemoVouchers" />
    </event>
    <event name="sales_creditmemo_item_save_after">
        <observer name="Webbhuset_CollectorCheckout_save_creditmemo_item_voucher"
                  instance="Webbhuset\CollectorCheckout\Observer\Voucher\SaveCreditmemoItemVoucher" />
    </event>
    <event name="sales_quote_save_after">
        <observer name="Webbhuset_CollectorCheckout_sales_quote_save_after" instance="Webbhuset\CollectorCheckout\Observer\QuoteSaveObserver" />
    </event>
</config>
