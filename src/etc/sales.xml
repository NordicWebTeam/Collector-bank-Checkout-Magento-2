<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Sales:etc/sales.xsd">
    <section name="quote">
        <group name="totals">
            <!-- After tax (450) and weee_tax (460), before grand_total (550) -->
            <item name="walley_voucher" instance="Webbhuset\CollectorCheckout\Model\Total\Quote\WalleyVoucher"
                  sort_order="470"/>
        </group>
    </section>
    <section name="order_invoice">
        <group name="totals">
            <!-- After tax (200) and cost_total (250), before grand_total (350) -->
            <item name="walley_voucher" instance="Webbhuset\CollectorCheckout\Model\Total\Invoice\WalleyVoucher"
                  sort_order="260"/>
        </group>
    </section>
    <section name="order_creditmemo">
        <group name="totals">
            <!-- After tax (250), before cost_total (300) and grand_total (400) -->
            <item name="walley_voucher" instance="Webbhuset\CollectorCheckout\Model\Total\Creditmemo\WalleyVoucher"
                  sort_order="260"/>
        </group>
    </section>
</config>
